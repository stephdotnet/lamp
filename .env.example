# To determine the name of your containers
COMPOSE_PROJECT_NAME=lamp

DOCUMENT_ROOT=./www
APACHE_DOCUMENT_ROOT=/var/www/html
LOG_DIR=./logs/apache2

# Config
VHOSTS_DIR=./config/vhosts
# php.ini par environnement. Laisse vide ou pointe sur ./config/php/php.ini
# en prod : c'est le fichier durci (display_errors=Off, expose_php=Off...).
# php-local.ini est genere par `make init`.
PHP_INI=./config/php/php-local.ini
SSL_DIR=./config/ssl

# Variante du webserver (cf. README, "Apache event + PHP-FPM"). Les deux lignes
# commentees = mod_php + prefork. Pour PHP-FPM + mpm_event, les decommenter : le
# dossier de build et l'image (construite par la CI, `docker compose pull`).
# WEBSERVER_BUILD=./bin/php82-fpm
# WEBSERVER_IMAGE=ghcr.io/stephdotnet/php82-fpm:latest

# Port allocation
HOST_MACHINE_UNSECURE_HOST_PORT=80
HOST_MACHINE_SECURE_HOST_PORT=443
HOST_MACHINE_MYSQL_PORT=3306
# Adminer : bind sur 127.0.0.1 uniquement, joint par `make adminer`
HOST_MACHINE_ADMINER_PORT=8080
# Beszel : bind sur 127.0.0.1 uniquement, joint par `make beszel`
HOST_MACHINE_BESZEL_PORT=8090

# Monitoring Beszel, a activer sur le serveur seulement (cf. README, Monitoring).
# COMPOSE_PROFILES=monitoring
# Cle et token donnes par le hub (Add System). Sans guillemets : le Makefile
# inclut ce fichier et les passerait tels quels a docker compose.
BESZEL_AGENT_KEY=
BESZEL_AGENT_TOKEN=

# Mysql configuration
MYSQL_INITDB_DIR=./config/initdb
MYSQL_DATA_DIR=./data/mysql
MYSQL_LOG_DIR=./logs/mysql

# MySQL root user password
MYSQL_ROOT_PASSWORD=tiger
MYSQL_USER=docker
MYSQL_PASSWORD=docker
MYSQL_DATABASE=docker

# If you already has the port 6379 in use, you can change it (for example if you have Redis)
REDIS_PASSWORD=redis
HOST_MACHINE_REDIS_PORT=6379

# Others
EMAIL_ADMIN=admin@example.com
CERTIFY_BASE_VIRTUAL_HOST=default.conf
NODE_TTY=false
